rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // 2. Referral Records (Deterministic: ref_referrerUid_referredUid)
    match /referrals/{referralId} {
      allow read: if true;
      // Cannot overwrite completed referral rewards
      allow create: if true;
      allow update: if resource.data.status != 'completed';
      allow delete: if request.auth != null;
    }

    // 3. Coin Transactions Ledger (Immutable ledger: tx_referralId_uid)
    match /coinTransactions/{transactionId} {
      allow read: if true;
      // Only append new transaction records, no modification/deletion of past transactions
      allow create: if true;
      allow update, delete: if false;
    }

    // 4. Referral Codes registry (RXA7K2 -> uid)
    match /referralCodes/{code} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // 5. Orders & Services
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // 6. Global Configuration & Announcements
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Payment requests & QR verification
    match /payment_requests/{paymentId} {
      allow read: if true;
      allow create, update: if true;
    }

    // 8. Activity logs
    match /logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // 9. Password Reset OTPs collection - Block direct client read/write to prevent network inspection
    match /otps/{email} {
      allow read, write: if false;
    }

    match /password_reset_otps/{otpId} {
      allow read, write: if true;
    }

    match /email_accounts/{accountId} {
      allow read, write: if true;
    }

    // Fallback for any other document
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

